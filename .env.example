# ====================================================================
# SIARD-UdeC · Configuración de Variables de Entorno
# ====================================================================

# Estándar de conexión a PostgreSQL (para pgAdmin y Node.js)
# Formato: postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BD
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siard_udec"

# Parámetros desglosados compatibles (opcional si se define DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siard_udec
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración del servidor y seguridad
PORT=3001
JWT_SECRET=siard_udec_jwt_super_secret_key_2026
ADMIN_SETUP_KEY=siard-setup-secret-2026
