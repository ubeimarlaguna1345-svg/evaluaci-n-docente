    "preview": "vite preview frontend --host 0.0.0.0",
    "test": "vitest run frontend/src/store.test.ts backend/models/models.test.js",
    "test:frontend": "vitest run --dir frontend",
    "test:backend": "vitest run backend/models/models.test.js"
  },
